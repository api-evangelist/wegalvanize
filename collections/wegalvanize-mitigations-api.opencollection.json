                "description": "The ID of the HighBond instance."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new mitigation.\n\n<strong>Limitations</strong>:\n* There can be a maximum of 200,000 mitigations per project or framework.\n* You cannot create a mitigation if the objective it belongs to has been checked out using\n<a href=\"https://help.highbond.com/helpdocs/highbond/en-us/Default.htm#cshid=pm-offline-client\" target=\"_blank\">Offline Projects</a> or the\n<a href=\"https://help.highbond.com/helpdocs/highbond/en-us/Default.htm#cshid=pm-mobile\" target=\"_blank\">HighBond iPad app</a>.\n"
        },
        {
          "info": {
            "name": "Get a mitigation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{server}/v1/orgs/:org_id/mitigations/:id",
            "params": [
              {
                "name": "org_id",
                "value": "",
