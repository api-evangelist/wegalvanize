            "name": "List of questionnaires\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{server}/v1/orgs/:org_id/collections/:collection_id/questionnaires",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "The ID of the HighBond instance."
              },
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "The ID of the collection."
              }
            ]
          },
          "docs": "Get a list of all questionnaires inside a collection."
        },
